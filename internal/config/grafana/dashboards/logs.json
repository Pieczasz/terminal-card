{
  "annotations": {"list": []},
  "description": "Application logs from Loki for production-terminal-card-server.",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["terminal-card", "logs"],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Terminal Card - Logs",
  "uid": "tc-logs",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log rate by level (5m)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (level) (rate({service_name=\"production-terminal-card-server\"} | json | __error__=\"\" [5m]))", "legendFormat": "{{level}}"}
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 8},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [
        {"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_name=\"production-terminal-card-server\"}"}
      ]
    }
  ]
}
