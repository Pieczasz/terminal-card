---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BackLink from "../../components/BackLink.astro";
import Base from "../../layouts/Base.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

// getStaticPaths cannot infer prop types back into the component, so declare them.
interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

const url = new URL(`/blog/${post.id}/`, Astro.site ?? "https://www.tty.cards")
  .href;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  // Google treats a BlogPosting without dateModified as never updated. Until posts
  // carry an explicit updated date, published is the honest answer.
  dateModified: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Pieczasz" },
  publisher: { "@type": "Organization", name: "tty.cards" },
  image: new URL("/og.png", Astro.site ?? "https://www.tty.cards").href,
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  inLanguage: "en",
};

// Breadcrumbs give the result a "tty.cards > blog > post" trail instead of a raw URL.
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: (Astro.site ?? new URL("https://www.tty.cards")).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", Astro.site ?? "https://www.tty.cards").href,
    },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};
---

<Base
  title={`${post.data.title} - tty.cards`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  article={{ published: post.data.date }}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(crumbs)}
    slot="head"
  />

  <article class="shell max-w-[82ch] pt-[clamp(5ch,7vw,9ch)]" data-hero>
    {/* A flex row rather than a sentence with a link in it: the arrow already gives
        the link a non-colour cue, and keeping it out of a text block is what stops
        axe's link-in-text-block rule (WCAG 1.4.1) from applying at all. */}
    <div
      class="flex flex-wrap items-center gap-x-panel gap-y-cell text-[0.8rem] tracking-[0.18em] uppercase"
    >
      <BackLink href="/blog/" label="blog" />
      <span class="text-dim">{post.data.date.toISOString().slice(0, 10)}</span>
    </div>

    <h1
      class="mt-gutter mb-[5ch] text-[clamp(1.4rem,3vw+0.6rem,2.3rem)] leading-[1.25] font-bold text-balance"
    >
      {post.data.title}
    </h1>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
