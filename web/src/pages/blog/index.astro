---
import { getCollection } from "astro:content";
import TerminalWindow from "../../components/TerminalWindow.astro";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, ".");

const base = Astro.site ?? new URL("https://www.tty.cards");

// A Blog node lets the index be understood as a feed of the posts below it, rather
// than as an unrelated page that happens to contain links.
const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "tty.cards - engineering notes",
  url: new URL("/blog/", base).href,
  inLanguage: "en",
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.date.toISOString(),
    url: new URL(`/blog/${p.id}/`, base).href,
  })),
};
---

<Base
  title="blog - tty.cards"
  description="Notes on building tty.cards: an SSH server for multiplayer card games in Go, its in-memory event broadcaster, and the Bubble Tea TUI."
  path="/blog/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
    slot="head"
  />
  <section class="shell pt-[clamp(5ch,7vw,10ch)]" data-hero>
    <h1
      class="mb-gutter text-[clamp(1.4rem,3vw+0.6rem,2.4rem)] leading-[1.2] font-bold text-balance"
    >
      How this thing is built.
    </h1>
    <p class="max-w-[62ch] text-[clamp(1rem,1.1vw+0.7rem,1.3rem)] text-muted text-pretty">
      Some random notes about the project, if you are interested.
    </p>
  </section>

  <section class="shell mt-bay" data-rise>
    {
      posts.length === 0 ? (
        <TerminalWindow title="posts" tone="quiet">
          <p class="text-dim">
            Nothing published yet. The first post is being written.
          </p>
        </TerminalWindow>
      ) : (
        <TerminalWindow
          title="posts"
          meta={`${posts.length}`}
          tone="gold"
          pad="px-panel py-cell"
        >
          <ul>
            {posts.map((p, i) => (
              <li class:list={[i > 0 && "border-t border-dotted border-frame"]}>
                <a
                  href={`/blog/${p.id}/`}
                  class="group/post grid gap-x-gutter gap-y-[0.4ch] py-gutter max-sm:grid-cols-1 sm:grid-cols-[minmax(0,12ch)_minmax(0,1fr)]"
                >
                  <span class="text-[0.9rem] tabular-nums text-dim">
                    {fmt(p.data.date)}
                  </span>
                  <span class="font-bold text-fg transition-colors group-hover/post:text-accent">
                    {p.data.title}
                  </span>
                  <span class="text-[0.93rem] text-dim text-pretty sm:col-start-2">
                    {p.data.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </TerminalWindow>
      )
    }
  </section>
</Base>
