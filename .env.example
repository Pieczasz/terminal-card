# Server Configuration
# For docker compose on a VPS: copy to .env and set a strong unique DB_PASSWORD.
# Compose sets ENV=production on the backend; do not publish SERVER_PORT (6969) on the host -
# only nginx should reach it (PROXY protocol). See README "Self-hosting" and SECURITY.md.
ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=6969
MAX_CONNECTIONS=1000
SSH_KEY_PATH=.wishlist/server
SERVICE_VERSION=0.1.0

# Rate limiting (SSH connections per IP)
RATE_LIMIT_CONNECTIONS=5
RATE_LIMIT_WINDOW_MS=1000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=terminal_card
DB_PASSWORD=your_local_database_password
# development default: disable | production default: require
DB_SSLMODE=disable
# Only for trusted internal networks when ENV=production and DB_SSLMODE=disable
# ALLOW_INSECURE_DB=true
DB_MAX_OPEN_CONNS=25

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# true/1 in development by default; set false for TLS to the collector
OTEL_EXPORTER_OTLP_INSECURE=true

# For make migrate-up / migrate-down (separate from the server's DB_* vars)
# DB_DSN=postgres://postgres:your_local_database_password@localhost:5432/terminal_card?sslmode=disable
